#!/bin/sh
# Pre-push gate: refuses a push to main or master (unless git.allowTrunkPush allows a fast-forward), then runs the blocking CA gates locally so a doc / skill / graph violation is caught
# before the push, not after a full pipeline cycle. When a passing pre-flight receipt covers the tree of the tip commit
# of each pushed ref (Test-PushReceipt.ps1), those gates already passed on that content and do not run again. A push that only
# deletes refs, or whose commits the remote already has, runs no gate. Then it hands on to Git LFS, so the LFS objects
# are uploaded. On a network share the gates run on a local checkout of the pushed commit (see is_network_path).
# Tool-agnostic: fires on any `git push`, whether
# from a terminal, Claude Code, or GitHub Copilot, because it is a git hook, not an agent feature.
#
# Enable once per clone:  pwsh .claude/skills/ai-sdlc-hooks/scripts/Initialize-AiSdlc.ps1
#                         (sets core.hooksPath to .claude/skills/ai-sdlc-hooks/githooks)
# Skip for one push:      git push --no-verify
#
# Runs only the fast BLOCKING gates of the installed packages. That run includes Check-DocDrift.ps1
# when the dotnet pack is installed, because its gates.json registers it as Blocking. Advisory scans
# are left to the full local run (`pwsh .claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1`) and
# to the pull request pipeline; coverage (C09) is left to the pre-flight.

# A push to main or master is refused before any gate runs. The agent hook Deny-IncompletePush.ps1
# refuses it in Claude Code; this is the same rule for every other tool and for a push from a terminal.
# A repository that sets git.allowTrunkPush to true in aisdlc.json may update main or master directly,
# but only as a fast-forward: a delete, and an update whose old tip is not an ancestor of the new one,
# stay refused. The blocking gates still run on such a push. The setting counts only in aisdlc.json of
# the commit that is the remote tip of that branch, which git passes on stdin. Without pwsh, the config
# module or that commit in the clone, the setting cannot be read, so the push is refused.
# git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# `git lfs pre-push` needs the same lines at the end, so they are read once and kept.
# The setting is read from aisdlc.json in the commit that is the tip of the remote branch now. git
# learns that commit from the remote while it pushes and passes it on stdin as <remote sha>, so neither
# an edit in the working tree nor a local ref can switch the setting on. A new branch (zero sha) or a tip
# that is not in this clone counts as off. $1 is that remote sha.
# core.hooksPath is relative, so $0 and the module path can be relative to the repository root, where git
# starts the hook. Import-Module reads a bare relative path as a module name, so the path is resolved first.
trunk_push_allowed() {
    is_zero_sha "$1" && return 1
    git cat-file -e "$1^{commit}" 2>/dev/null || return 1
    command -v pwsh >/dev/null 2>&1 || return 1
    module="$(dirname "$0")/../../ai-sdlc-gates/scripts/AiSdlcConfig.psm1"
    [ -f "$module" ] || return 1
    AISDLC_CONFIG_MODULE="$module" AISDLC_REPO_ROOT="$(git rev-parse --show-toplevel)" AISDLC_REF="$1"         pwsh -NoProfile -NonInteractive -Command 'try { Import-Module (Resolve-Path -LiteralPath $env:AISDLC_CONFIG_MODULE).ProviderPath -Force; if (Test-AiSdlcTrunkPushAllowed -RepoRoot $env:AISDLC_REPO_ROOT -Ref $env:AISDLC_REF) { exit 0 } } catch { }; exit 1' >/dev/null 2>&1
}

is_zero_sha() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

refs=$(cat)
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            branch=${remote_ref#refs/heads/}
            if ! trunk_push_allowed "$remote_sha"; then
                echo "pre-push: a push to $branch is refused. A change reaches main only through a pull request that a person reviews and merges. Push the story branch and open or update its pull request instead." >&2
                if ! is_zero_sha "$remote_sha" && ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
                    echo "pre-push: the remote tip of $branch is not in this clone, so git.allowTrunkPush cannot be read from it. If the setting is on $branch, fetch first, then push again." >&2
                fi
                exit 1
            fi
            if is_zero_sha "$local_sha"; then
                echo "pre-push: git.allowTrunkPush in aisdlc.json allows an update of $branch, not a delete. The delete is refused." >&2
                exit 1
            fi
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                echo "pre-push: git.allowTrunkPush in aisdlc.json allows a fast-forward of $branch, not a force push. The push is refused." >&2
                exit 1
            fi
            echo "pre-push: git.allowTrunkPush in aisdlc.json allows this fast-forward of $branch. The blocking gates still run."
            ;;
    esac
done <<EOF
$refs
EOF

# On a network share every gate reads every file over the network, which is slow. There the gates run on
# a local checkout of the pushed commit: a detached git worktree in a temp folder, removed after the run.
# So they also check what is pushed, not the working tree. It is used only when one commit is pushed.
# AISDLC_GATES_LOCAL_CHECKOUT=1 forces it, and =0 turns it off.
# git rev-parse --show-toplevel prints a share root with forward slashes, //host/share/..., also for a
# mapped drive letter.
is_network_path() {
    case "$1" in
        //*) return 0 ;;
        *) return 1 ;;
    esac
}

# Prints the folder the gates run in: a new local checkout of commit $2, or the repository root $1 itself.
# A checkout without the gate runner (the commit does not track .claude/) is removed again.
gate_root_for() {
    want=${AISDLC_GATES_LOCAL_CHECKOUT:-}
    if [ -z "$want" ]; then
        if is_network_path "$1"; then want=1; else want=0; fi
    fi
    if [ "$want" = 1 ] && [ -n "$2" ]; then
        # The checkout goes in a subfolder of the private (0700) temp folder, so no other user can put
        # anything in its place.
        dir=$(mktemp -d 2>/dev/null) || dir=
        if [ -n "$dir" ]; then
            if git -C "$1" worktree add --quiet --detach "$dir/wt" "$2" >/dev/null 2>&1 &&
                [ -f "$dir/wt/.claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1" ]; then
                echo "$dir/wt"
                return 0
            fi
            git -C "$1" worktree remove --force "$dir/wt" >/dev/null 2>&1
            rm -rf "$dir"
        fi
    fi
    echo "$1"
}

run_gates() (
    repo_root=$(git rev-parse --show-toplevel)
    runner="$repo_root/.claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1"

    if [ ! -f "$runner" ]; then
        # Not in a tree that has the gates (e.g. an old branch); do not block.
        return 0
    fi

    if command -v pwsh >/dev/null 2>&1; then
        PWSH=pwsh
    else
        echo "pre-push: PowerShell 7 (pwsh) not found; skipping local gates. Install pwsh to enforce them before push." >&2
        return 0
    fi

    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

    pushed=$(printf '%s\n' "$refs" | awk 'NF >= 2 { print $2 }' | tr '\n' ' ')
    nothing_new="$repo_root/.claude/skills/ai-sdlc-gates/scripts/Test-PushSendsNothingNew.ps1"
    if [ -f "$nothing_new" ] && why=$("$PWSH" -NoProfile -File "$nothing_new" -RepoRoot "$repo_root" -Remote "$1" -Commit "$pushed" 2>/dev/null); then
        echo "pre-push: $why"
        return 0
    fi

    receipt_check="$repo_root/.claude/skills/ai-sdlc-gates/scripts/Test-PushReceipt.ps1"
    if [ -f "$receipt_check" ] && "$PWSH" -NoProfile -File "$receipt_check" -RepoRoot "$repo_root" -Commit "$pushed" >/dev/null 2>&1; then
        echo "pre-push: a passing pre-flight receipt covers the tip commit of each pushed ref, so the blocking gates do not run again."
        status=0
    else
        tips=$(printf '%s\n' "$refs" | awk 'NF >= 2 && $2 !~ /^0+$/ { print $2 }' | sort -u)
        [ "$(printf '%s\n' "$tips" | grep -c .)" -eq 1 ] || tips=
        gate_root=$(gate_root_for "$repo_root" "$tips")
        if [ "$gate_root" != "$repo_root" ]; then
            trap 'git -C "$repo_root" worktree remove --force "$gate_root" >/dev/null 2>&1; rm -rf "$(dirname "$gate_root")"' EXIT
            trap 'exit 130' INT TERM
            echo "pre-push: the gates run on a local checkout of $tips, because the repository is on a network share."
            cd "$gate_root" || return 1
            # The git data of the checkout sits on the share, which another user owns, so git refuses the
            # checkout as "dubious ownership". Then gitleaks scanned 0 commits and still passed. This trusts
            # the one checkout folder, only for the gates and through the environment; the git config of
            # the machine stays as it is. Git on Windows names the folder C:/..., so cygpath converts it.
            safe_dir=$(cygpath -m "$gate_root" 2>/dev/null) || safe_dir=$gate_root
            n=${GIT_CONFIG_COUNT:-0}
            export "GIT_CONFIG_KEY_$n=safe.directory" "GIT_CONFIG_VALUE_$n=$safe_dir" "GIT_CONFIG_COUNT=$((n + 1))"
            runner="$gate_root/.claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1"
        fi
        echo "pre-push: running blocking CA gates ($runner -BlockingOnly)..."
        "$PWSH" -NoProfile -File "$runner" -BlockingOnly
        status=$?
    fi

    # Advisory: reports when behaviour moved while its tests or docs stood still. Its gate is Advisory,
    # so the -BlockingOnly run above leaves it out; this call keeps the report visible on every push,
    # for every tool, without failing it.
    completeness="${gate_root:-$repo_root}/.claude/skills/ai-sdlc-gates/scripts/Check-ChangeCompleteness.ps1"
    # Advisory as well, for the same reason: lists the pages whose "Last checked" date is older than
    # docs.lastCheckedMaxAgeDays. It prints nothing when the setting is off or every date is recent.
    last_checked="${gate_root:-$repo_root}/.claude/skills/ai-sdlc-gates/scripts/Check-DocLastChecked.ps1"
    if [ -f "$last_checked" ]; then
        "$PWSH" -NoProfile -File "$last_checked" -Quiet || true
    fi

    if [ -f "$completeness" ]; then
        "$PWSH" -NoProfile -File "$completeness" || true
    fi

    if [ "$status" -ne 0 ]; then
        echo "" >&2
        echo "pre-push: blocking gate(s) failed. Fix the issues above, or push with --no-verify to bypass intentionally." >&2
        return 1
    fi
    return 0
)

run_gates "$1" || exit 1

# Last, once the push may go ahead: upload the LFS objects of the pushed commits, the step the
# stock LFS pre-push hook did before core.hooksPath pointed git here. See git-lfs-hook next to this file.
[ -n "$refs" ] || exit 0
printf '%s\n' "$refs" | "$(dirname "$0")/git-lfs-hook" pre-push "$@"
exit $?
