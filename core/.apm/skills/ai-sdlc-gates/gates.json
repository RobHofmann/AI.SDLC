{
  "package": "core",
  "gates": [
    { "name": "C03 no secret outside gitleaks-baseline.json (gitleaks)", "script": "scripts/Test-GitleaksBaseline.ps1", "clause": "C03", "mode": "Blocking" },
    { "name": "C02 no source line-number citations", "script": "scripts/Check-DocLineCitations.ps1", "clause": "C02", "mode": "Blocking" },
    { "name": "AI-SDLC artifact-graph links resolve", "script": "scripts/Check-ArtifactGraph.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "C05 docs wiki: no orphans, broken links or isolated pages", "script": "scripts/Check-DocsWiki.ps1", "clause": "C05", "mode": "Blocking", "args": { "Strict": true } },
    { "name": "C05 docs index in sync", "script": "scripts/Build-DocsIndex.ps1", "clause": "C05", "mode": "Blocking", "args": { "Check": true } },
    { "name": "C06 no em-dash characters", "script": "scripts/Check-DocEmDashes.ps1", "clause": "C06", "mode": "Blocking" },
    { "name": "AGENTS.md stays small enough to be read whole", "script": "scripts/Check-AgentsFileSize.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "AI.SDLC sync: every file of the installed packages is in .claude/, unchanged", "script": "scripts/Check-SyncManifest.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "AI.SDLC local packages: every local package in apm.yml and apm.lock.yaml is a folder in git", "script": "scripts/Check-LocalPackages.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "AGENTS.md shared parts match the installed packages", "script": "scripts/Sync-AgentsFile.ps1", "clause": "AI-SDLC", "mode": "Blocking", "args": { "Check": true } },
    { "name": "House-style: reading level (B2 sentences, B1 words)", "script": "scripts/Check-DocReadingLevel.ps1", "clause": "C11", "mode": "Blocking" },
    { "name": "AI-SDLC skill hygiene, with the failure-mode and signal sections", "script": "scripts/Check-SkillHygiene.ps1", "clause": "AI-SDLC", "mode": "Blocking", "args": { "Strict": true } },
    { "name": "AI-SDLC agent hygiene: explicit tools, edit tools only for a listed writer, a known persona", "script": "scripts/Check-AgentHygiene.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "House-style: no internal contributor names in docs", "script": "scripts/Check-DocPersonNames.ps1", "clause": "C08", "mode": "Blocking" },
    { "name": "House-style: every documented row carries a fact", "script": "scripts/Check-DocRowContent.ps1", "clause": "house-style", "mode": "Blocking", "args": { "FailOnFinding": true } },
    { "name": "Change completeness: tests and docs moved with the code", "script": "scripts/Check-ChangeCompleteness.ps1", "clause": "AI-SDLC", "mode": "Advisory", "args": { "Strict": true } },
    { "name": "PR hygiene: the PR names its story and keeps its description (CI/PR only; no-op locally)", "script": "scripts/Check-PrHygiene.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "AI-SDLC no private term in a public repository (skipped when private)", "script": "scripts/Check-PrivateTerms.ps1", "clause": "AI-SDLC", "mode": "Blocking" },
    { "name": "C05 a pointer names a section that is there", "script": "scripts/Check-DocSectionRefs.ps1", "clause": "C05", "mode": "Blocking" },
    { "name": "C05 both doc layers exist, and every unit has a page", "script": "scripts/Check-DocCoverage.ps1", "clause": "C05", "mode": "Blocking" },
    { "name": "Allow rules of the installed packages are in .claude/settings.json", "script": "scripts/Sync-AllowRules.ps1", "clause": "AI-SDLC", "mode": "Advisory", "args": { "Check": true } }
  ],
  "allow": [
    "pwsh -NoProfile -File .claude/skills/ai-sdlc-gates/scripts/Check-*",
    "pwsh .claude/skills/ai-sdlc-gates/scripts/Check-*",
    "pwsh -NoProfile -File .claude/skills/ai-sdlc-gates/scripts/Build-DocsIndex.ps1*",
    "pwsh .claude/skills/ai-sdlc-gates/scripts/Build-DocsIndex.ps1*",
    "pwsh -NoProfile -File .claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1*",
    "pwsh .claude/skills/ai-sdlc-gates/scripts/Invoke-LocalGates.ps1*",
    "pwsh -NoProfile -File .claude/skills/ai-sdlc-gates/scripts/Invoke-Preflight.ps1*",
    "pwsh .claude/skills/ai-sdlc-gates/scripts/Invoke-Preflight.ps1*",
    "pwsh -NoProfile -File .claude/skills/ai-sdlc-gates/scripts/Invoke-PesterGate.ps1*",
    "pwsh .claude/skills/ai-sdlc-gates/scripts/Invoke-PesterGate.ps1*",
    "git status *",
    "git diff *",
    "git log *",
    "git show *",
    "git add *",
    "git commit *",
    "git fetch *",
    "git switch *",
    "git checkout -b *",
    "git branch --show-current*",
    "git rev-parse *",
    "git merge-base *",
    "git push",
    "git push origin *",
    "git push --set-upstream origin *",
    "git push -u origin *"
  ]
}
